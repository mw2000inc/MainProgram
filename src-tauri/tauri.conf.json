{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MW2000",
  "version": "0.1.0",
  "identifier": "com.mw2000.erp",
  "build": {
    "frontendDist": "https://mainprogram-neon.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "MW2000",
        "url": "https://mainprogram-neon.vercel.app",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
